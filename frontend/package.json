{
  "name": "invoice-frontend",
  "version": "1.0.0",
  "description": "发票管理系统前端",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src/ --ext .js,.vue",
    "lint:fix": "eslint src/ --ext .js,.vue --fix",
    "format": "prettier --write \"src/**/*.{js,vue,css,scss,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,vue,css,scss,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@mdi/font": "^7.4.0",
    "axios": "^1.6.0",
    "docx": "^9.7.1",
    "pinia": "^2.1.0",
    "vue": "^3.4.0",
    "vue-router": "^4.2.0",
    "vuetify": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^9.24.0",
    "eslint-plugin-vue": "^9.33.0",
    "happy-dom": "^20.10.6",
    "prettier": "^3.5.3",
    "sass": "^1.69.0",
    "vite": "^5.0.0",
    "vitest": "^4.1.9"
  }
}
