# 数据库 — 开发环境默认使用 SQLite，无需额外配置
DATABASE_URL=sqlite:///./invoice.db

# 文件上传目录（相对于 backend/）
UPLOAD_DIR=../uploads
MAX_FILE_SIZE_MB=10
STORAGE_THRESHOLD_MB=1

# OCR 引擎 — 默认使用本地 Tesseract
OCR_ENGINE=local
# Tesseract 安装路径（留空则自动从 runtime/ 查找，或使用系统 PATH）
TESSERACT_PATH=
# Poppler 安装路径（留空则自动从 runtime/ 查找，或使用系统 PATH）
POPPLER_PATH=

# 应用监听
HOST=0.0.0.0
PORT=8000

# CORS 允许的域名（开发环境用 *，生产改为实际域名）
CORS_ORIGINS=*

# 应用信息
APP_TITLE=发票管理系统
APP_VERSION=1.0.1

# 管理后台鉴权（reset/backup 端点）
# 生产环境必须设置；留空则本地开发跳过校验（不推荐）
ADMIN_TOKEN=
