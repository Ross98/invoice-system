# ============================================================
# 发票管理系统 - 生产环境配置模板
# 使用方法: cp .env.production backend/.env
# ============================================================

# 数据库 (SQLite)
DATABASE_URL=sqlite:///./invoice.db

# 文件上传
UPLOAD_DIR=data/uploads
MAX_FILE_SIZE_MB=10
STORAGE_THRESHOLD_MB=1

# OCR 引擎 (Docker 中 tesseract/pdftoppm 在 PATH 中，留空即可)
OCR_ENGINE=local
TESSERACT_PATH=
POPPLER_PATH=

# 应用监听
HOST=0.0.0.0
PORT=8000

# CORS 允许的域名（生产环境替换为实际域名，多个用逗号分隔）
# 示例: CORS_ORIGINS=https://invoice.your-domain.com,https://www.your-domain.com
CORS_ORIGINS=*

# 应用信息
APP_TITLE=发票管理系统
APP_VERSION=1.0.1
